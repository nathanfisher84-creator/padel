// PostgreSQL variant of the schema, used for production deploys (Vercel).
// Keep the models in sync with prisma/schema.prisma (the SQLite dev schema) —
// only the datasource provider differs. The `vercel-build` script in
// package.json points Prisma at this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // PLAYER | COACH | ADMIN
  createdAt    DateTime @default(now())

  coachProfile       CoachProfile?
  paymentsMade       Payment[]         @relation("PlayerPayments")
  paymentsReceived   Payment[]         @relation("CoachPayments")
  subscriptions      Subscription[]    @relation("PlayerSubscriptions")
  coachSubscriptions Subscription[]    @relation("CoachSubscriptions")
  submissions        VideoSubmission[] @relation("PlayerSubmissions")
  reviewQueue        VideoSubmission[] @relation("CoachSubmissions")
  reviewsWritten     Review[]          @relation("PlayerReviews")
  reviewsReceived    Review[]          @relation("CoachReviews")
}

model CoachProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline          String
  // Short "best for …" tag surfaced on coach cards to aid the player's choice.
  bestFor           String?
  bio               String
  location          String?
  experienceYears   Int      @default(0)
  photoUrl          String?
  introVideoUrl     String?
  // Trust pack: coach-committed response time and structured credentials.
  turnaroundHours   Int      @default(72)
  languages         String?
  certifications    String?
  careerHighlights  String?
  // Each coach sets their own rates (stored in minor units, e.g. cents).
  oneOffPriceCents  Int
  monthlyPriceCents Int
  monthlyVideoLimit Int      @default(4)
  currency          String   @default("AED")
  isPublished       Boolean  @default(false)
  // True for the built-in AI coach (Nova): free chat, paid instant reviews
  // generated automatically; the platform keeps 100% of its payments.
  isAi              Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Subscription {
  id               String    @id @default(cuid())
  playerId         String
  player           User      @relation("PlayerSubscriptions", fields: [playerId], references: [id], onDelete: Cascade)
  coachId          String
  coach            User      @relation("CoachSubscriptions", fields: [coachId], references: [id], onDelete: Cascade)
  status           String // ACTIVE | CANCELED
  currentPeriodEnd DateTime
  stripeSubId      String?
  createdAt        DateTime  @default(now())
  payments         Payment[]

  @@unique([playerId, coachId])
}

model Payment {
  id               String        @id @default(cuid())
  playerId         String
  player           User          @relation("PlayerPayments", fields: [playerId], references: [id], onDelete: Cascade)
  coachId          String
  coach            User          @relation("CoachPayments", fields: [coachId], references: [id], onDelete: Cascade)
  kind             String // ONE_OFF | SUBSCRIPTION_CYCLE
  amountCents      Int
  // Revenue split, computed at payment time from PLATFORM_FEE_PERCENT.
  platformFeeCents Int
  coachCents       Int
  currency         String
  status           String // PENDING | PAID | FAILED
  stripeRef        String?       @unique
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt        DateTime      @default(now())

  submission VideoSubmission?
}

model VideoSubmission {
  id        String   @id @default(cuid())
  playerId  String
  player    User     @relation("PlayerSubmissions", fields: [playerId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("CoachSubmissions", fields: [coachId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  // Comma-separated shot keys the player wants analysed (see FOCUS_SHOTS).
  focusShots String?
  videoPath String
  // Set when the raw video file was deleted by the retention cron (30 days
  // after the review was delivered). Feedback and timestamped notes remain.
  videoPurgedAt DateTime?
  status    String // AWAITING_FEEDBACK | REVIEWED
  // Reminder ladder for the coach's committed turnaround: 0 = none sent,
  // 1 = approaching-deadline nudge sent, 2 = overdue notice sent.
  reminderStage Int @default(0)
  // Set when the submission consumed a one-off review credit.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])
  createdAt DateTime @default(now())

  feedback Feedback?
  review   Review?
  comments FeedbackComment[]
}

model Feedback {
  id           String          @id @default(cuid())
  submissionId String          @unique
  submission   VideoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  content      String
  videoUrl     String?
  createdAt    DateTime        @default(now())
}

// A coach's note pinned to a specific moment in the player's uploaded video.
// The player can click the timestamp to jump straight to that point.
model FeedbackComment {
  id           String          @id @default(cuid())
  submissionId String
  submission   VideoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  timeSeconds  Float
  body         String
  createdAt    DateTime        @default(now())

  @@index([submissionId])
}

// A player's rating of a delivered video review. One per submission,
// only possible after feedback exists.
model Review {
  id           String          @id @default(cuid())
  submissionId String          @unique
  submission   VideoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  playerId     String
  player       User            @relation("PlayerReviews", fields: [playerId], references: [id], onDelete: Cascade)
  coachId      String
  coach        User            @relation("CoachReviews", fields: [coachId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  createdAt    DateTime        @default(now())
}

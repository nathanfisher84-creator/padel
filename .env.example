# Copy to .env and adjust.

# SQLite for local development. For production use PostgreSQL and change
# the provider in prisma/schema.prisma, e.g.
#   DATABASE_URL="postgresql://user:pass@host:5432/padel"
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the app (used for Stripe redirect URLs).
APP_URL="http://localhost:3000"

# Percentage of every payment kept by the platform owner (default 20).
# The remainder is credited to the coach.
PLATFORM_FEE_PERCENT="20"

# Stripe (optional). Leave unset to run in demo-payment mode, where
# purchases complete instantly without a real charge.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Where uploaded videos are stored (default: ./uploads).
# UPLOAD_DIR="/var/data/padel-uploads"

# Vercel Blob (optional). Set automatically by Vercel when a Blob store is
# connected to the project; enables direct browser-to-storage video uploads.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Google Gemini API key, optional but powers two features:
#  1. AI Coach video reviews — the built-in "PadelPro AI Coach" watches player
#     uploads and generates instant feedback with timestamped notes. Without a
#     key, dev/preview deployments serve a clearly-labelled demo review and
#     production reports the AI coach unavailable.
#  2. AI-standardized coach profile photos (consistent studio headshots).
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY="AIza..."
# Override the model ids if they are renamed:
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# GEMINI_VIDEO_MODEL="gemini-2.5-flash"

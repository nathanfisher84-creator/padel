# Copy to .env and adjust.

# SQLite for local development. For production use PostgreSQL and change
# the provider in prisma/schema.prisma, e.g.
#   DATABASE_URL="postgresql://user:pass@host:5432/padel"
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the app (used for Stripe redirect URLs).
APP_URL="http://localhost:3000"

# Percentage of every payment kept by the platform owner (default 20).
# The remainder is credited to the coach.
PLATFORM_FEE_PERCENT="20"

# Stripe (optional). Leave unset to run in demo-payment mode, where
# purchases complete instantly without a real charge.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Where uploaded videos are stored (default: ./uploads).
# UPLOAD_DIR="/var/data/padel-uploads"

# Protects the storage-retention cron (/api/cron/purge-videos, scheduled in
# vercel.json), which deletes raw video files 30 days after their review was
# delivered. Vercel sets this header automatically when the env var exists:
# generate one with `openssl rand -hex 32`. Required in production.
# CRON_SECRET="..."

# Vercel Blob (optional). Enables direct browser-to-storage video uploads.
# IMPORTANT: the read-write token is REQUIRED for uploads even when the store
# is connected in OIDC mode — the SDK's OIDC fallback covers server-side blob
# calls only and cannot mint the browser client tokens (uploads fail with
# "Failed to retrieve the client token" without it). Copy it from the Blob
# store's settings in the Vercel dashboard.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Email notifications via Resend (https://resend.com), optional. When set:
#  - coaches get an email when a player uploads a video for them
#  - players get an email when their feedback is delivered
#  - the owner gets an email on every sale and every AI coach upload
# Without a key, emails are simply off and nothing blocks.
# RESEND_API_KEY="re_..."
# From address; the default (onboarding@resend.dev) works before you verify a
# domain in Resend, but only delivers to your own Resend account email.
# EMAIL_FROM="PadelPro <notifications@yourdomain.com>"
# Where owner sale/AI alerts go (falls back to ADMIN_EMAIL).
# OWNER_NOTIFY_EMAIL="you@example.com"

# Google Gemini API key, optional but powers the AI features:
#  1. Nova, the AI coach — free padel chat plus paid instant video reviews
#     (Nova watches the full upload and pins timestamped notes). Without a
#     key, dev/preview deployments serve a clearly-labelled demo review and
#     production reports the AI coach unavailable.
#  2. AI-standardized coach profile photos (consistent studio headshots).
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY="AIza..."
# Override the model ids if they are renamed:
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# GEMINI_VIDEO_MODEL="gemini-2.5-flash"
# GEMINI_TEXT_MODEL="gemini-2.5-flash"
# Dev only: exercise the AI coach chat UX with canned responses (no key needed).
# AI_COACH_FAKE="1"
